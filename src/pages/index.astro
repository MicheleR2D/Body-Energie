<Layout
	title="Body Energie - Villafranca di Verona | Sport, Fitness e Salute"
	description="Body Energie: fitness, benessere e sport a Villafranca di Verona. Sala pesi, corsi fitness, acqua fitness, Body Lab e molto altro su oltre 5.500 mq."
>
	<HeroCarousel images={heroImages}>
		<h1 class="hero__title" data-anim="up">BODY <span class="accent-text">ENERGIE</span></h1>
		<p class="hero__lead" data-anim="up" data-anim-delay="200">Dove sport, movimento e benessere si incontrano.</p>
		<div data-anim="up" data-anim-delay="400">
			<button class="btn hero__btn" type="button" data-open-contact data-interest="prova-gratuita">Prova ora</button>
		</div>
	</HeroCarousel>

	<section class="block--black">
		<div data-anim="fade">
			<PhotoMarquee images={fotoCarosello} />
		</div>
	</section>

	<section class="block--orange">
		<div class="storia__inner">
			<div
				class="storia__foto"
				data-anim="from-left"
				style="background-image:url(/wp-content/uploads/2025/07/stabile-body-energie.jpg)"
			/>
			<div class="storia__testo-col">
				<blockquote class="storia__quote" data-anim="from-right">La nostra Storia,<br />il tuo Benessere</blockquote>
				<div class="storia__testo" data-anim="fade">
					<p>
						<strong>Body Energie nasce in una tiepida serata di novembre del 1994</strong>, al ritorno da un
						allenamento. Ci siamo chiesti perché a Villafranca non esistesse un luogo capace di accogliere persone,
						non solo body builder: uno spazio semplice, piacevole, dove allenarsi con serenità e anche con
						divertimento. Da quel pensiero, quasi uno scherzo, è nato un sogno. E dopo soli due mesi e mezzo,
						<strong>il 28 febbraio 1995, abbiamo inaugurato il nostro centro</strong>.
					</p>
					<p>
						Da allora siamo guidati dalla stessa passione: migliorare ogni giorno, ascoltare i nostri clienti e
						cogliere le novità più interessanti del mondo fitness e wellness. La crescita è arrivata naturale: la
						struttura aveva bisogno di nuovi spazi, nuove energie, nuove possibilità. Così, nel 1998, abbiamo
						iniziato a progettare il nostro grande traguardo: il Centro del Benessere.
					</p>
					<p>
						<strong>Oggi Body Energie è molto più di una palestra</strong>: è una dimensione dove movimento, salute
						e benessere si incontrano. <strong>Un luogo in cui sentirsi bene, davvero</strong>.
					</p>
				</div>
			</div>
		</div>
		<div class="contatori">
			{
				contatori.map((c, i) => (
					<div class="contatore" data-anim="up" data-anim-delay={String(i * 120)}>
						<span class="contatore__numero" data-counter data-target={c.target} data-suffix={c.suffisso}>
							0
						</span>
						<span class="contatore__titolo">{c.titolo}</span>
						<span class="contatore__sub">{c.sotto}</span>
					</div>
				))
			}
		</div>
	</section>

	<script>
		const counters = document.querySelectorAll('[data-counter]');
		// Il sito originale mostra i numeri con la virgola (5,500) invece del
		// punto italiano: replichiamo lo stesso formato, non e' un refuso nostro.
		const formatta = (n: number) => n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
		const anima = (el: Element) => {
			const target = Number(el.getAttribute('data-target'));
			const suffix = el.getAttribute('data-suffix') || '';
			const durata = 1500;
			const inizio = performance.now();
			function tick(ora: number) {
				const progresso = Math.min(1, (ora - inizio) / durata);
				const valore = Math.floor(progresso * target);
				el.textContent = formatta(valore) + suffix;
				if (progresso < 1) requestAnimationFrame(tick);
				else el.textContent = formatta(target) + suffix;
			}
			requestAnimationFrame(tick);
		};
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						anima(entry.target);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.4 }
		);
		counters.forEach((c) => observer.observe(c));
	</script>

	<script>
		// Allinea la foto della sezione "storia" al titolo (stesso spazio arancione
		// sopra) e ne riduce l'altezza fino a coincidere con la fine della prima
		// colonna di testo, cosi' i due elementi condividono lo stesso "inizio" e
		// la stessa "fine" a schermo.
		function allineaFotoStoria() {
			const foto = document.querySelector<HTMLElement>('.storia__foto');
			const col = document.querySelector<HTMLElement>('.storia__testo-col');
			const testo = document.querySelector('.storia__testo');
			if (!foto || !col || !testo) return;

			if (window.matchMedia('(max-width: 900px)').matches) {
				foto.style.marginTop = '';
				foto.style.height = '';
				return;
			}

			const range = document.createRange();
			range.selectNodeContents(testo);
			const righe = Array.from(range.getClientRects());
			if (!righe.length) return;

			const testoLeft = testo.getBoundingClientRect().left;
			const primaColonna = righe.filter((r) => Math.abs(r.left - testoLeft) < 2);
			const fineColonna1 = primaColonna.length
				? Math.max(...primaColonna.map((r) => r.bottom))
				: testo.getBoundingClientRect().bottom;

			const colTop = col.getBoundingClientRect().top;
			const spazioSopra = parseFloat(getComputedStyle(col).paddingTop);

			foto.style.marginTop = `${spazioSopra}px`;
			foto.style.height = `${fineColonna1 - colTop - spazioSopra}px`;
		}

		allineaFotoStoria();
		window.addEventListener('resize', allineaFotoStoria);
		document.fonts?.ready.then(allineaFotoStoria);
	</script>

	<script>
		// La linea sotto ai titoli "attivita" parte dal bordo della sezione
		// (non dal rientro del testo) e sottolinea tutto il titolo: la sua
		// larghezza va quindi calcolata dal bordo del blocco fino alla fine
		// del testo del titolo, non e' un valore fisso.
		function allineaLineeAttivita() {
			// Titoli allineati a sinistra (attivita, struttura): la linea parte
			// dal bordo della sezione e arriva fino alla fine del testo.
			document.querySelectorAll<HTMLElement>('.attivita__line, .struttura__line').forEach((linea) => {
				const blocco = linea.closest<HTMLElement>('.attivita__block') ?? linea.closest<HTMLElement>('section');
				const titolo = blocco?.querySelector<HTMLElement>('h2');
				if (!blocco || !titolo) return;
				const fineTitolo = bordoSinistro(titolo) + titolo.offsetWidth;
				linea.style.width = `${fineTitolo - bordoSinistro(blocco)}px`;
			});

			// Titolo allineato a destra (testimonianze): la linea segue
			// semplicemente la larghezza del testo, non quella della sezione.
			document.querySelectorAll<HTMLElement>('.testimonianze__line').forEach((linea) => {
				const titolo = linea.closest('section')?.querySelector<HTMLElement>('h2');
				if (titolo) linea.style.width = `${titolo.offsetWidth}px`;
			});
		}

		// Misure di layout (offset*), non getBoundingClientRect: i titoli con
		// animazione in entrata restano traslati finche' non compaiono.
		function bordoSinistro(el: HTMLElement) {
			let x = 0;
			for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) x += n.offsetLeft;
			return x;
		}

		allineaLineeAttivita();
		window.addEventListener('resize', allineaLineeAttivita);
		document.fonts?.ready.then(allineaLineeAttivita);
	</script>

