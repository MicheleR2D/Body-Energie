---
/*
 * Planning settimanale dei corsi. I dati (src/data/orario-corsi.json) sono quelli del
 * widget HTML della pagina "Planning Orari" del vecchio sito; qui diventano una pagina
 * del sito. Tutti i giorni stanno nell'HTML (si leggono anche senza JavaScript); con
 * JavaScript compaiono i tab dei giorni e il filtro per categoria.
 */
import Layout from '../layouts/Layout.astro';
import orario from '../data/orario-corsi.json';

type Voce = { ora: string; nome: string; cat: string; lesMills?: boolean; nuovo?: boolean };

const GIORNI = [
	{ id: 'LUN', nome: 'Lunedì' },
	{ id: 'MAR', nome: 'Martedì' },
	{ id: 'MER', nome: 'Mercoledì' },
	{ id: 'GIO', nome: 'Giovedì' },
	{ id: 'VEN', nome: 'Venerdì' },
	{ id: 'SAB', nome: 'Sabato' },
	{ id: 'DOM', nome: 'Domenica' },
];

const categorie = Object.entries(orario.categorie as Record<string, string>);

// Raggruppa le lezioni per orario (restano in ordine).
function perOrario(voci: Voce[]) {
	const mappa = new Map<string, Voce[]>();
	for (const v of voci) mappa.set(v.ora, [...(mappa.get(v.ora) ?? []), v]);
	return [...mappa.entries()];
}

const giorni = GIORNI.map((g) => ({ ...g, righe: perOrario((orario.giorni as Record<string, Voce[]>)[g.id]) }));
---

<Layout
	title="Planning settimanale - Body Energie | Villafranca di Verona"
	description={`Orario dei corsi di Body Energie, stagione ${orario.stagione}: Dinamica, Attiva, Respira, Acqua e Forma, giorno per giorno.`}
	headerTone="overlay"
>
	<section class="or-hero">
		<p class="pill or-hero__pill" data-intro>Stagione {orario.stagione}</p>
		<h1 class="display-title or-hero__title" data-intro style="--intro-delay: 0.1s">
			Orario <em>corsi</em>
		</h1>
		<p class="or-hero__valid" data-intro style="--intro-delay: 0.2s">{orario.validita}</p>
	</section>

	<section class="or" data-or>
		<div class="or__controls container-wide">
			<div class="or__tabs" role="tablist" aria-label="Giorno della settimana">
				{
					giorni.map((g, i) => (
						<button type="button" role="tab" class="or__tab" id={`or-tab-${g.id}`} aria-controls={`or-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-giorno={g.id}>
							<span aria-hidden="true">{g.id}</span>
							<span class="or__sr">{g.nome}</span>
						</button>
					))
				}
			</div>

			<div class="or__cats" role="group" aria-label="Filtra per categoria">
				<button type="button" class="or__cat is-on" aria-pressed="true" data-cat="all">
					<span class="or__dot" style="--c:#8a8a8a"></span>Tutti
				</button>
				{
					categorie.map(([id, nome]) => (
						<button type="button" class="or__cat" aria-pressed="false" data-cat={id}>
							<span class={`or__dot or__dot--${id}`}></span>
							{nome}
						</button>
					))
				}
			</div>
		</div>

		<div class="or__giorni container-wide">
			{
				giorni.map((g, i) => (
					<section class:list={['or__day', { 'is-on': i === 0 }]} id={`or-${g.id}`} role="tabpanel" aria-labelledby={`or-tab-${g.id}`}>
						<h2 class="or__day-title">{g.nome}</h2>
						{g.righe.map(([ora, voci]) => (
							<div class="or__row">
								<p class="or__time">{ora}</p>
								<ul class="or__cards">
									{voci.map((v) => (
										<li class={`or__card or__card--${v.cat}`} data-c={v.cat}>
											<span class="or__name">
												{v.nome}
												{v.nuovo && <span class="or__badge or__badge--new">★ New</span>}
												{v.lesMills && <span class="or__badge">LM</span>}
											</span>
											<span class="or__sub">{(orario.categorie as Record<string, string>)[v.cat]}</span>
										</li>
									))}
								</ul>
							</div>
						))}
					</section>
				))
			}
			<p class="or__empty" role="status" hidden>Nessun corso in questa categoria nel giorno scelto.</p>
		</div>

		<p class="or__note container-wide" set:html={orario.note} />
	</section>
</Layout>

<style>
	/* ---- Testata ---- */
	.or-hero {
		padding: calc(var(--header-h) + 48px) var(--gutter) 48px;
		background: var(--bg-dark);
		color: var(--text-on-dark);
		text-align: center;
	}

	.or-hero__pill {
		margin: 0 0 18px;
	}

	.or-hero__title {
		color: var(--text-on-dark);
		text-transform: uppercase;
	}

	.or-hero__title em {
		font-style: italic;
		color: var(--accent);
	}

	.or-hero__valid {
		margin: 20px 0 0;
		font-size: var(--text-sm);
		letter-spacing: 0.04em;
		color: var(--text-on-dark);
	}

	/* ---- Planning ---- */
	.or {
		padding-block: 32px clamp(48px, 7vw, 96px);
		background: var(--bg);
		color: var(--text);
	}

	.or__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* Senza JavaScript i controlli non servono: si vedono tutti i giorni di fila. */
	:global(html:not(.js)) .or__controls {
		display: none;
	}

	.or__controls {
		position: sticky;
		top: var(--header-h);
		z-index: 5;
		display: grid;
		gap: 12px;
		padding-block: 12px;
		background: var(--bg);
	}

	.or__tabs {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 6px;
	}

	.or__tab {
		min-height: 44px;
		padding: 8px 4px;
		border: 2px solid var(--border-strong);
		border-radius: var(--radius);
		background: transparent;
		color: var(--text);
		font: inherit;
		font-weight: 800;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: background var(--dur-base), color var(--dur-base), border-color var(--dur-base);
	}

	.or__tab:hover {
		border-color: var(--accent);
	}

	.or__tab[aria-selected='true'] {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--text);
	}

	.or__cats {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.or__cat {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 6px 16px;
		border: 2px solid var(--border-strong);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 700;
		cursor: pointer;
		transition: background var(--dur-base), border-color var(--dur-base);
	}

	.or__cat:hover {
		border-color: var(--text);
	}

	.or__cat[aria-pressed='true'] {
		border-color: var(--text);
		background: var(--text);
		color: var(--text-on-dark);
	}

	.or__dot {
		width: 10px;
		height: 10px;
		flex: none;
		border-radius: 50%;
		background: var(--c);
	}

	/* Colori delle categorie: gli stessi del planning originale. */
	.or__dot--d,
	.or__card--d {
		--c: #e8720c;
	}
	.or__dot--a,
	.or__card--a {
		--c: #bf5a07;
	}
	.or__dot--r,
	.or__card--r {
		--c: #3d9e45;
	}
	.or__dot--q,
	.or__card--q {
		--c: #1e8fd4;
	}
	.or__dot--f,
	.or__card--f {
		--c: #c9a020;
	}

	/* ---- Giorni e righe ---- */
	.or__day {
		padding-bottom: 8px;
	}

	:global(html.js) .or__day:not(.is-on) {
		display: none;
	}

	.or__day-title {
		margin: 28px 0 8px;
		font-size: var(--text-xl);
		font-weight: 900;
		color: var(--text);
	}

	:global(html.js) .or__day-title {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: 0;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.or__row {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 14px;
		padding: 14px 0;
		border-top: 1px solid var(--border-strong);
	}

	.or__time {
		margin: 6px 0 0;
		font-size: var(--text-md);
		font-weight: 900;
		color: var(--accent-hover);
	}

	.or__cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.or__card {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 14px;
		border-left: 5px solid var(--c);
		border-radius: var(--radius);
		background: var(--bg-alt);
	}

	.or__name {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		font-weight: 800;
	}

	.or__sub {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.or__badge {
		padding: 1px 8px;
		border-radius: var(--radius-pill);
		background: var(--bg-dark);
		color: var(--text-on-dark);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.or__badge--new {
		background: var(--accent);
		color: var(--text);
	}

	/* display: flex/grid sulle righe e sulle card annullerebbe l'attributo hidden. */
	.or__card[hidden],
	.or__row[hidden],
	.or__empty[hidden] {
		display: none;
	}

	.or__empty {
		margin: 32px 0;
		font-weight: 700;
		text-align: center;
		color: var(--text-muted);
	}

	.or__note {
		margin: 32px 0 0;
		padding-block: 20px;
		border-top: 1px solid var(--border-strong);
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--text-muted);
	}

	@media (max-width: 560px) {
		.or__row {
			grid-template-columns: 3.4rem minmax(0, 1fr);
			gap: 10px;
		}

		.or__tabs {
			gap: 4px;
		}

		.or__tab {
			font-size: var(--text-sm);
		}
	}
</style>

<script>
	const radice = document.querySelector<HTMLElement>('[data-or]');
	if (radice) {
		const tab = [...radice.querySelectorAll<HTMLButtonElement>('.or__tab')];
		const giorni = [...radice.querySelectorAll<HTMLElement>('.or__day')];
		const cat = [...radice.querySelectorAll<HTMLButtonElement>('.or__cat')];
		const vuoto = radice.querySelector<HTMLElement>('.or__empty')!;
		let categoria = 'all';

		function applica() {
			let visibili = 0;
			for (const g of giorni) {
				for (const riga of g.querySelectorAll<HTMLElement>('.or__row')) {
					let n = 0;
					for (const c of riga.querySelectorAll<HTMLElement>('.or__card')) {
						const mostra = categoria === 'all' || c.dataset.c === categoria;
						c.hidden = !mostra;
						if (mostra) n++;
					}
					riga.hidden = n === 0;
					if (g.classList.contains('is-on')) visibili += n;
				}
			}
			vuoto.hidden = visibili > 0;
		}

		function vaiAlGiorno(id: string, sposta = false) {
			tab.forEach((t) => {
				const on = t.dataset.giorno === id;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				if (on && sposta) t.focus();
			});
			giorni.forEach((g) => g.classList.toggle('is-on', g.id === 'or-' + id));
			applica();
		}

		tab.forEach((t, i) => {
			t.addEventListener('click', () => vaiAlGiorno(t.dataset.giorno!));
			t.addEventListener('keydown', (e) => {
				const passo = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (!passo) return;
				e.preventDefault();
				vaiAlGiorno(tab[(i + passo + tab.length) % tab.length].dataset.giorno!, true);
			});
		});

		cat.forEach((b) =>
			b.addEventListener('click', () => {
				categoria = b.dataset.cat!;
				cat.forEach((x) => {
					x.classList.toggle('is-on', x === b);
					x.setAttribute('aria-pressed', String(x === b));
				});
				applica();
			})
		);

		// Si parte dal giorno di oggi (getDay: 0 = domenica).
		const oggi = ['DOM', 'LUN', 'MAR', 'MER', 'GIO', 'VEN', 'SAB'][new Date().getDay()];
		vaiAlGiorno(oggi);
	}
</script>
