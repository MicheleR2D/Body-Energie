---
// Riga di "accordion orizzontale": card affiancate che si aprono in
// larghezza. Chiusa mostra una singola immagine ferma; aperta mostra le
// foto in una striscia scorrevole (avanzamento automatico + trascinamento
// manuale + frecce). Solo una card puo' restare aperta in tutta la sezione:
// aprirne una chiude qualunque altra, anche in un'altra riga.
import Img from './Img.astro';

interface Item {
	title: string;
	html: string;
	images: string[];
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;

// id stabili e univoci (dai titoli) per collegare bottone, titolo e pannello.
const slug = (t: string) =>
	t
		.toLowerCase()
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
---

<div class="srow" data-srow data-anim="reveal">
	{
		items.map((item) => {
			const id = `scard-${slug(item.title)}`;
			return (
				<div class="scard" data-scard>
					<div class="scard__visual">
						<div class="scard__track" data-scard-track>
							{item.images.map((src) => (
								<Img src={src} class="scard__slide" sizes="(max-width: 900px) 100vw, 46vw" />
							))}
						</div>
						<div class="scard__scrim" />
						<h3 class="scard__title" id={`${id}-title`}>
							{item.title}
						</h3>
						{item.images.length > 1 && (
							<>
								<button
									class="btn scard__nav scard__nav--prev"
									type="button"
									data-scard-prev
									aria-label={`${item.title}: foto precedente`}
								>
									←
								</button>
								<button
									class="btn scard__nav scard__nav--next"
									type="button"
									data-scard-next
									aria-label={`${item.title}: foto successiva`}
								>
									→
								</button>
							</>
						)}
					</div>

					{/* Chiuso = inert: il testo nascosto non viene letto ne' raggiunto con Tab. */}
					<div class="scard__panel" id={`${id}-panel`} inert>
						<div class="scard__panel-inner">
							<p class="scard__panel-title" aria-hidden="true">
								{item.title}
							</p>
							<div class="scard__text" set:html={item.html} />
						</div>
					</div>

					<button
						class="btn scard__toggle"
						type="button"
						id={`${id}-btn`}
						data-scard-toggle
						aria-expanded="false"
						aria-controls={`${id}-panel`}
						aria-labelledby={`${id}-btn ${id}-title`}
					>
						<span class="scard__toggle-icon" data-scard-icon aria-hidden="true">
							→
						</span>
						<span data-scard-label>Apri</span>
					</button>
				</div>
			);
		})
	}
</div>

<script>
	const allCards = Array.from(document.querySelectorAll<HTMLElement>('[data-scard]'));
	const allRows = Array.from(document.querySelectorAll<HTMLElement>('[data-srow]'));
	const timers = new WeakMap<HTMLElement, number>();
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function trackOf(card: HTMLElement) {
		return card.querySelector<HTMLElement>('[data-scard-track]');
	}

	// La rotazione automatica parte solo se serve davvero: card aperta, pagina
	// visibile, nessuno che ci sta sopra col mouse o dentro con la tastiera, e
	// niente se la persona ha chiesto di ridurre i movimenti.
	function startAuto(track: HTMLElement) {
		stopAuto(track);
		if (reduceMotion.matches) return;
		const id = window.setInterval(() => {
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
			if (atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
			else track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
		}, 3200);
		timers.set(track, id);
	}

	function stopAuto(track: HTMLElement) {
		const id = timers.get(track);
		if (id) window.clearInterval(id);
	}

	function shouldAutoplay(card: HTMLElement) {
		return (
			card.classList.contains('is-open') &&
			!document.hidden &&
			!card.querySelector('.scard__visual')?.matches(':hover') &&
			!card.contains(document.activeElement)
		);
	}

	function setOpen(card: HTMLElement | null) {
		allCards.forEach((c) => {
			const isOpen = c === card;
			c.classList.toggle('is-open', isOpen);
			const btn = c.querySelector<HTMLButtonElement>('[data-scard-toggle]');
			const label = c.querySelector('[data-scard-label]');
			const icon = c.querySelector('[data-scard-icon]');
			const panel = c.querySelector<HTMLElement>('.scard__panel');
			if (btn) btn.setAttribute('aria-expanded', String(isOpen));
			if (label) label.textContent = isOpen ? 'Chiudi' : 'Apri';
			if (icon) icon.textContent = isOpen ? '←' : '→';
			if (panel) panel.inert = !isOpen;

			const track = trackOf(c);
			if (!track) return;
			if (isOpen) {
				if (shouldAutoplay(c)) startAuto(track);
			} else {
				stopAuto(track);
				track.scrollTo({ left: 0, behavior: 'auto' });
			}
		});
		allRows.forEach((row) => row.classList.toggle('has-open', !!card && row.contains(card)));
	}

	function step(track: HTMLElement, dir: number) {
		const max = track.scrollWidth - track.clientWidth;
		let target = track.scrollLeft + dir * track.clientWidth;
		if (target > max + 2) target = 0;
		else if (target < -2) target = max;
		track.scrollTo({ left: target, behavior: 'smooth' });
	}

	// Scheda in secondo piano: niente scorrimento a vuoto; al ritorno riparte.
	document.addEventListener('visibilitychange', () => {
		allCards.forEach((c) => {
			const track = trackOf(c);
			if (!track) return;
			if (document.hidden) stopAuto(track);
			else if (shouldAutoplay(c)) startAuto(track);
		});
	});

	allCards.forEach((card) => {
		const track = trackOf(card);
		const visual = card.querySelector<HTMLElement>('.scard__visual');
		// Dopo un trascinamento il rilascio genera un click: non deve chiudere la card.
		let suppressClick = false;

		// Si apre/chiude cliccando ovunque sulla card, non solo sul bottone
		// (che resta come indicazione visiva, non come unico innesco).
		card.addEventListener('click', () => {
			if (suppressClick) return;
			setOpen(card.classList.contains('is-open') ? null : card);
		});

		if (!track || !visual) return;

		card.querySelectorAll<HTMLButtonElement>('[data-scard-prev], [data-scard-next]').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				step(track, btn.hasAttribute('data-scard-next') ? 1 : -1);
			});
		});

		// Trascinamento col mouse (touch e trackpad scorrono gia' in modo nativo).
		let dragging = false;
		let startX = 0;
		let startScroll = 0;
		track.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0 || !card.classList.contains('is-open')) return;
			dragging = true;
			startX = e.clientX;
			startScroll = track.scrollLeft;
			track.style.scrollSnapType = 'none';
			track.classList.add('is-dragging');
		});
		track.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			if (Math.abs(dx) > 5 && !track.hasPointerCapture(e.pointerId)) track.setPointerCapture(e.pointerId);
			track.scrollLeft = startScroll - dx;
		});
		// Vale anche quando il rilascio avviene fuori dalla card (lostpointercapture).
		const endDrag = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			track.classList.remove('is-dragging');
			if (Math.abs(e.clientX - startX) > 5) {
				suppressClick = true;
				window.setTimeout(() => (suppressClick = false), 80);
			}
			const index = Math.round(track.scrollLeft / track.clientWidth);
			track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
			window.setTimeout(() => (track.style.scrollSnapType = ''), 400);
		};
		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);
		track.addEventListener('lostpointercapture', endDrag);

		// La rotazione automatica si ferma mentre si interagisce con la card
		// (mouse sopra le foto o focus da tastiera) e riparte quando si esce.
		const pause = () => stopAuto(track);
		const resume = () => {
			if (shouldAutoplay(card)) startAuto(track);
		};
		visual.addEventListener('mouseenter', pause);
		visual.addEventListener('mouseleave', resume);
		card.addEventListener('focusin', pause);
		card.addEventListener('focusout', (e) => {
			if (!card.contains(e.relatedTarget as Node | null)) resume();
		});
	});
</script>

<style>
	.srow {
		display: flex;
		gap: 6px;
		height: 340px;
		padding-inline: var(--gutter);
		margin-bottom: 16px;
	}

	.scard {
		position: relative;
		display: flex;
		flex: 1 1 0;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--bg);
		/* clip-path: srotolamento in entrata della riga (data-anim="reveal"). */
		transition:
			flex-grow 0.85s var(--ease-out-crit),
			clip-path 1.1s var(--ease-out-crit);
	}

	.scard + .scard {
		transition-delay: 0s, 0.15s;
	}

	.scard.is-open {
		flex-grow: 2.4;
	}

	.srow.has-open .scard:not(.is-open) {
		flex-grow: 0.7;
	}

	/* --- Striscia immagine: si restringe da dentro la card quando si apre,
	   dando l'impressione che il pannello di testo emerga da li'. --- */
	.scard__visual {
		position: relative;
		flex: 1 1 100%;
		min-width: 0;
		overflow: hidden;
		transition: flex-basis 0.85s var(--ease-out-crit);
	}

	.scard.is-open .scard__visual {
		flex: 0 0 34%;
	}

	/* Chiusa: una sola immagine ferma (niente scroll). Aperta: striscia
	   scorrevole che avanza da sola ma si puo' anche trascinare a mano. */
	.scard__track {
		position: absolute;
		inset: 0;
		display: flex;
		overflow-x: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.scard__track::-webkit-scrollbar {
		display: none;
	}

	.scard.is-open .scard__track {
		overflow-x: auto;
		cursor: grab;
	}

	.scard__track.is-dragging {
		cursor: grabbing;
		user-select: none;
	}

	/* Frecce del carosello: solo a card aperta. Usano il sistema bottoni
	   globale (bordo bianco, riempimento in hover) in versione tonda. */
	.scard__nav {
		--btn-border: var(--text-on-dark);
		--btn-hover-text: var(--accent);
		position: absolute;
		top: calc(50% - 22px);
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border-radius: 50%;
		background: rgba(10, 10, 10, 0.35);
		font-size: 18px;
		line-height: 1;
		/* Chiusa: nascosta davvero (visibility), non solo trasparente, cosi' la
		   tastiera non ci entra con Tab. */
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.3s ease, visibility 0s linear 0.3s, color 0.35s ease, transform 0.25s var(--ease-out-crit);
	}

	.scard__nav--prev {
		left: 12px;
	}

	.scard__nav--next {
		right: 12px;
	}

	.scard.is-open .scard__nav {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition-delay: 0.4s, 0s, 0s, 0s;
	}

	.scard__track :global(.scard__slide) {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		scroll-snap-align: start;
	}

	.scard__scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(0deg, rgba(10, 10, 10, 0.75) 0%, rgba(10, 10, 10, 0.1) 45%, rgba(10, 10, 10, 0.3) 100%);
		pointer-events: none;
	}

	.scard__title {
		position: absolute;
		left: 20px;
		bottom: 16px;
		z-index: 2;
		margin: 0;
		max-width: calc(100% - 40px);
		font-family: var(--font-heading);
		font-size: 19px;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--text-on-dark);
		pointer-events: none;
	}

	/* Bottone apri/chiudi: ancorato alla card intera (non alla striscia
	   immagine che si restringe), cosi' "chiudi" resta dove era "apri" e
	   non costringe l'utente a rincorrerlo. Nessuno sfondo. */
	.scard__toggle {
		position: absolute;
		right: 4px;
		bottom: 10px;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 6px;
		background: none;
		border: none;
		padding: 6px 12px;
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-on-dark);
		cursor: pointer;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
	}

	/* E' un <button>: eredita dal sistema globale il riempimento in hover e
	   lo zoom. Essendo ancorato al bordo destro della card (che ha
	   overflow:hidden), lo zoom deve crescere verso sinistra (non verso
	   destra) per non essere tagliato dal bordo. */
	.scard__toggle {
		transform-origin: right center;
	}

	.scard.is-open .scard__toggle {
		color: var(--text);
		text-shadow: none;
	}

	.scard__toggle-icon {
		color: var(--accent);
		font-size: 18px;
		line-height: 1;
	}

	/* --- Pannello testo: parte a larghezza zero dentro la card e si apre
	   in orizzontale, come se uscisse da dietro la striscia immagine. --- */
	.scard__panel {
		flex: 0 0 0%;
		min-width: 0;
		overflow: hidden;
		background: var(--bg);
		transition: flex-basis 0.85s var(--ease-out-crit);
	}

	.scard.is-open .scard__panel {
		flex: 1 1 66%;
	}

	.scard__panel-inner {
		width: 100%;
		height: 100%;
		padding: 24px 28px;
		overflow-y: auto;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.scard.is-open .scard__panel-inner {
		opacity: 1;
		transition-delay: 0.4s;
	}

	.scard__panel-title {
		margin: 0 0 8px;
		font-family: var(--font-heading);
		font-size: 19px;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--accent);
	}

	.scard__text {
		color: var(--text);
		font-size: var(--text-sm);
		line-height: 1.55;
	}

	.scard__text :global(p) {
		margin: 0 0 0.8em;
	}

	.scard__text :global(p:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 900px) {
		.srow {
			flex-direction: column;
			height: auto;
		}

		.scard {
			flex: 0 0 auto;
			flex-direction: column;
			height: 220px;
		}

		.scard.is-open {
			height: auto;
		}

		.scard.is-open .scard__visual {
			flex-basis: 180px;
		}

		.scard.is-open .scard__panel {
			flex-basis: auto;
		}
	}
</style>
