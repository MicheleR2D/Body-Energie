---
// Riga di "accordion orizzontale": card affiancate che si aprono in
// larghezza. Chiusa mostra una singola immagine ferma; aperta mostra le
// foto in una striscia scorrevole (avanzamento automatico + trascinamento
// manuale). Solo una card puo' restare aperta in tutta la sezione: aprirne
// una chiude qualunque altra, anche in un'altra riga.
interface Item {
	title: string;
	html: string;
	images: string[];
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---

<div class="srow" data-srow data-anim="reveal">
	{
		items.map((item) => (
			<div class="scard" data-scard>
				<div class="scard__visual">
					<div class="scard__track" data-scard-track>
						{item.images.map((src) => (
							<div class="scard__slide" style={`background-image:url(${src})`} />
						))}
					</div>
					<div class="scard__scrim" />
					<h3 class="scard__title">{item.title}</h3>
					{item.images.length > 1 && (
						<>
							<button class="scard__nav scard__nav--prev" type="button" data-scard-prev aria-label="Foto precedente">
								←
							</button>
							<button class="scard__nav scard__nav--next" type="button" data-scard-next aria-label="Foto successiva">
								→
							</button>
						</>
					)}
				</div>

				<div class="scard__panel">
					<div class="scard__panel-inner">
						<h4 class="scard__panel-title">{item.title}</h4>
						<div class="scard__text" set:html={item.html} />
					</div>
				</div>

				<button class="scard__toggle" type="button" data-scard-toggle aria-expanded="false">
					<span class="scard__toggle-icon" data-scard-icon aria-hidden="true">
						→
					</span>
					<span class="scard__toggle-label" data-scard-label>
						Apri
					</span>
				</button>
			</div>
		))
	}
</div>

<script>
	const allCards = Array.from(document.querySelectorAll<HTMLElement>('[data-scard]'));
	const allRows = Array.from(document.querySelectorAll<HTMLElement>('[data-srow]'));
	const timers = new WeakMap<HTMLElement, number>();

	function startAuto(track: HTMLElement) {
		stopAuto(track);
		const id = window.setInterval(() => {
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
			if (atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
			else track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
		}, 3200);
		timers.set(track, id);
	}

	function stopAuto(track: HTMLElement) {
		const id = timers.get(track);
		if (id) window.clearInterval(id);
	}

	function setOpen(card: HTMLElement | null) {
		allCards.forEach((c) => {
			const isOpen = c === card;
			c.classList.toggle('is-open', isOpen);
			const btn = c.querySelector<HTMLButtonElement>('[data-scard-toggle]');
			const label = c.querySelector('[data-scard-label]');
			const icon = c.querySelector('[data-scard-icon]');
			if (btn) btn.setAttribute('aria-expanded', String(isOpen));
			if (label) label.textContent = isOpen ? 'Chiudi' : 'Apri';
			if (icon) icon.textContent = isOpen ? '←' : '→';

			const track = c.querySelector<HTMLElement>('[data-scard-track]');
			if (!track) return;
			if (isOpen) startAuto(track);
			else {
				stopAuto(track);
				track.scrollTo({ left: 0, behavior: 'auto' });
			}
		});
		allRows.forEach((row) => row.classList.toggle('has-open', !!card && row.contains(card)));
	}

	function step(track: HTMLElement, dir: number) {
		const max = track.scrollWidth - track.clientWidth;
		let target = track.scrollLeft + dir * track.clientWidth;
		if (target > max + 2) target = 0;
		else if (target < -2) target = max;
		track.scrollTo({ left: target, behavior: 'smooth' });
	}

	allCards.forEach((card) => {
		const track = card.querySelector<HTMLElement>('[data-scard-track]');
		const visual = card.querySelector<HTMLElement>('.scard__visual');
		// Dopo un trascinamento il rilascio genera un click: non deve chiudere la card.
		let suppressClick = false;

		// Si apre/chiude cliccando ovunque sulla card, non solo sul bottone
		// (che resta come indicazione visiva, non come unico innesco).
		card.addEventListener('click', () => {
			if (suppressClick) {
				suppressClick = false;
				return;
			}
			setOpen(card.classList.contains('is-open') ? null : card);
		});

		if (!track || !visual) return;

		card.querySelectorAll<HTMLButtonElement>('[data-scard-prev], [data-scard-next]').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				step(track, btn.hasAttribute('data-scard-next') ? 1 : -1);
			});
		});

		// Trascinamento col mouse (touch e trackpad scorrono gia' in modo nativo).
		let dragging = false;
		let startX = 0;
		let startScroll = 0;
		track.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || !card.classList.contains('is-open')) return;
			dragging = true;
			startX = e.clientX;
			startScroll = track.scrollLeft;
			track.style.scrollSnapType = 'none';
			track.classList.add('is-dragging');
		});
		track.addEventListener('pointermove', (e) => {
			if (!dragging) return;
			const dx = e.clientX - startX;
			if (Math.abs(dx) > 5 && !track.hasPointerCapture(e.pointerId)) track.setPointerCapture(e.pointerId);
			track.scrollLeft = startScroll - dx;
		});
		const endDrag = (e: PointerEvent) => {
			if (!dragging) return;
			dragging = false;
			track.classList.remove('is-dragging');
			if (Math.abs(e.clientX - startX) > 5) suppressClick = true;
			const index = Math.round(track.scrollLeft / track.clientWidth);
			track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
			window.setTimeout(() => (track.style.scrollSnapType = ''), 400);
		};
		track.addEventListener('pointerup', endDrag);
		track.addEventListener('pointercancel', endDrag);

		// La rotazione automatica si ferma mentre si interagisce con le foto.
		visual.addEventListener('mouseenter', () => stopAuto(track));
		visual.addEventListener('mouseleave', () => {
			if (card.classList.contains('is-open')) startAuto(track);
		});
	});
</script>

<style>
	.srow {
		display: flex;
		gap: 6px;
		height: 340px;
		padding-inline: 5%;
		margin-bottom: 16px;
	}

	.scard {
		position: relative;
		display: flex;
		flex: 1 1 0;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--bg);
		/* clip-path: srotolamento in entrata della riga (data-anim="reveal"). */
		transition:
			flex-grow 0.85s var(--ease-out-crit),
			clip-path 1.1s var(--ease-out-crit);
	}

	.scard + .scard {
		transition-delay: 0s, 0.15s;
	}

	.scard.is-open {
		flex-grow: 2.4;
	}

	.srow.has-open .scard:not(.is-open) {
		flex-grow: 0.7;
	}

	/* --- Striscia immagine: si restringe da dentro la card quando si apre,
	   dando l'impressione che il pannello di testo emerga da li'. --- */
	.scard__visual {
		position: relative;
		flex: 1 1 100%;
		min-width: 0;
		overflow: hidden;
		transition: flex-basis 0.85s var(--ease-out-crit);
	}

	.scard.is-open .scard__visual {
		flex: 0 0 34%;
	}

	/* Chiusa: una sola immagine ferma (niente scroll). Aperta: striscia
	   scorrevole che avanza da sola ma si puo' anche trascinare a mano. */
	.scard__track {
		position: absolute;
		inset: 0;
		display: flex;
		overflow-x: hidden;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.scard__track::-webkit-scrollbar {
		display: none;
	}

	.scard.is-open .scard__track {
		overflow-x: auto;
		cursor: grab;
	}

	.scard__track.is-dragging {
		cursor: grabbing;
		user-select: none;
	}

	/* Frecce del carosello: solo a card aperta. Usano il sistema bottoni
	   globale (bordo bianco, riempimento in hover) in versione tonda. */
	.scard__nav {
		--btn-border: var(--text-on-dark);
		--btn-hover-text: var(--accent);
		position: absolute;
		top: calc(50% - 20px);
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border-radius: 50%;
		background: rgba(10, 10, 10, 0.35);
		font-size: 18px;
		line-height: 1;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease, color 0.35s ease, transform 0.25s var(--ease-out-crit, ease);
	}

	.scard__nav--prev {
		left: 12px;
	}

	.scard__nav--next {
		right: 12px;
	}

	.scard.is-open .scard__nav {
		opacity: 1;
		pointer-events: auto;
		transition-delay: 0.4s, 0s, 0s;
	}

	.scard__slide {
		flex: 0 0 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		scroll-snap-align: start;
	}

	.scard__scrim {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(0deg, rgba(10, 10, 10, 0.75) 0%, rgba(10, 10, 10, 0.1) 45%, rgba(10, 10, 10, 0.3) 100%);
		pointer-events: none;
	}

	.scard__title {
		position: absolute;
		left: 20px;
		bottom: 16px;
		z-index: 2;
		margin: 0;
		max-width: calc(100% - 40px);
		font-family: var(--font-heading);
		font-size: 19px;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--text-on-dark);
		pointer-events: none;
	}

	/* Bottone apri/chiudi: ancorato alla card intera (non alla striscia
	   immagine che si restringe), cosi' "chiudi" resta dove era "apri" e
	   non costringe l'utente a rincorrerlo. Nessuno sfondo. */
	.scard__toggle {
		position: absolute;
		right: 4px;
		bottom: 10px;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 6px;
		background: none;
		border: none;
		padding: 6px 12px;
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-on-dark);
		cursor: pointer;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
	}

	/* E' un <button>: eredita dal sistema globale il riempimento in hover e
	   lo zoom. Essendo ancorato al bordo destro della card (che ha
	   overflow:hidden), lo zoom deve crescere verso sinistra (non verso
	   destra) per non essere tagliato dal bordo. */
	.scard__toggle {
		transform-origin: right center;
	}

	.scard.is-open .scard__toggle {
		color: var(--text);
		text-shadow: none;
	}

	.scard__toggle-icon {
		color: var(--accent);
		font-size: 18px;
		line-height: 1;
	}

	/* --- Pannello testo: parte a larghezza zero dentro la card e si apre
	   in orizzontale, come se uscisse da dietro la striscia immagine. --- */
	.scard__panel {
		flex: 0 0 0%;
		min-width: 0;
		overflow: hidden;
		background: var(--bg);
		transition: flex-basis 0.85s var(--ease-out-crit);
	}

	.scard.is-open .scard__panel {
		flex: 1 1 66%;
	}

	.scard__panel-inner {
		width: 100%;
		height: 100%;
		padding: 24px 28px;
		overflow-y: auto;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.scard.is-open .scard__panel-inner {
		opacity: 1;
		transition-delay: 0.4s;
	}

	.scard__panel-title {
		margin: 0 0 8px;
		font-family: var(--font-heading);
		font-size: 19px;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--accent);
	}

	.scard__text {
		color: var(--text);
		font-size: var(--text-sm);
		line-height: 1.55;
	}

	.scard__text :global(p) {
		margin: 0 0 0.8em;
	}

	.scard__text :global(p:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 900px) {
		.srow {
			flex-direction: column;
			height: auto;
		}

		.scard {
			flex: 0 0 auto;
			flex-direction: column;
			height: 220px;
		}

		.scard.is-open {
			height: auto;
		}

		.scard.is-open .scard__visual {
			flex-basis: 180px;
		}

		.scard.is-open .scard__panel {
			flex-basis: auto;
		}
	}
</style>
