---
import { megaMenu } from '../data/nav';
---

<header class="hd">
	<div class="hd__bar container">
		<a class="hd__logo" href="/" aria-label="Body Energie - Home"></a>

		<button class="hd__toggle" type="button" aria-label="Apri il menu" aria-expanded="false" data-hd-toggle>
			<span></span><span></span><span></span>
		</button>

		<nav class="hd__nav" data-hd-nav>
			<ul class="hd__mega">
				{
					megaMenu.map((colonna) => (
						<li class="hd__col">
							<span class="hd__col-title">
								{colonna.titolo}
								<svg class="hd__chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
									<path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.5" fill="none" />
								</svg>
							</span>
							<ul>
								{colonna.voci.map((voce) => (
									<li>
										<a href={voce.href}>{voce.label}</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
			<div class="hd__actions">
				<button
					class="btn btn--outline hd__cta hd__cta--contact"
					type="button"
					data-open-contact
					data-interest="informazioni"
				>
					Contattaci
				</button>
				<a class="btn hd__cta hd__cta--primary" href="/abbonamenti">I nostri abbonamenti</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector('[data-hd-toggle]');
	const nav = document.querySelector('[data-hd-nav]');
	const impostaMenu = (aperto) => {
		nav?.classList.toggle('hd__nav--aperto', aperto);
		toggle?.setAttribute('aria-expanded', aperto ? 'true' : 'false');
		toggle?.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
		document.documentElement.classList.toggle('hd-lock', aperto);
	};
	toggle?.addEventListener('click', () => impostaMenu(!nav?.classList.contains('hd__nav--aperto')));
	// Si chiude con un tap su un link o sul bottone contatti, con Esc o
	// tornando a una larghezza desktop.
	nav?.addEventListener('click', (e) => {
		if (e.target instanceof Element && e.target.closest('a, button')) impostaMenu(false);
	});
	document.addEventListener('keydown', (e) => e.key === 'Escape' && impostaMenu(false));
	window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && impostaMenu(false));

	// L'header cambia colore (sfondo a gradiente, voci col colore che
	// prima era lo sfondo) appena si inizia a scorrere la pagina.
	const header = document.querySelector('.hd');
	const aggiornaScroll = () => header?.classList.toggle('hd--scrolled', window.scrollY > 10);
	aggiornaScroll();
	window.addEventListener('scroll', aggiornaScroll, { passive: true });
</script>

<style>
	.hd {
		/* Sfondo bianco leggermente trasparente sempre (anche in cima):
		   logo e simbolo del menu' sono neri e si perderebbero sulle
		   sezioni scure. */
		--hd-h: 61px;
		border-bottom: 1px solid var(--border);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 40;
	}

	/* Lo sfondo sta in un pseudo-elemento: backdrop-filter sull'header stesso
	   farebbe da contenitore al menu' mobile (position: fixed) e lo
	   ridurrebbe all'altezza della barra. */
	.hd::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgba(255, 255, 255, 0.82);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	.hd__col-title,
	.hd__chevron {
		color: var(--text);
	}

	.hd__col + .hd__col::before {
		background: var(--accent);
	}

	.hd__chevron {
		margin-left: 4px;
		vertical-align: middle;
	}

	.hd__actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.hd__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 8px;
	}

	.hd__logo {
		text-decoration: none;
		display: block;
		-webkit-tap-highlight-color: transparent;
		width: 113px;
		height: 44px;
		background-image: url('/wp-content/uploads/2025/10/Logo-Body-Energie-header.png');
		background-repeat: no-repeat;
		background-position: left center;
		background-size: contain;
	}

	.hd__toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		padding: 8px;
	}

	.hd__toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text);
	}

	.hd__nav {
		display: flex;
		align-items: center;
		flex: 1;
	}

	/* Margini automatici sui due lati: il menu resta sempre esattamente a
	   meta' strada tra il logo e i bottoni, qualunque sia la loro larghezza. */
	.hd__mega {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 20px;
		margin-inline: auto;
		padding: 0;
	}

	.hd__col {
		position: relative;
	}

	.hd__col + .hd__col::before {
		content: '';
		position: absolute;
		left: -10px;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 22px;
	}

	.hd__col-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		cursor: default;
	}

	.hd__col > ul {
		list-style: none;
		margin: 0;
		padding: 12px;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 220px;
		background: var(--bg);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: 0.15s ease;
	}

	.hd__col:hover > ul,
	.hd__col:focus-within > ul {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.hd__col > ul li a {
		display: block;
		padding: 6px 4px;
		color: var(--text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.hd__col > ul li a:hover {
		color: var(--accent);
	}

	.hd__cta {
		white-space: normal;
		font-size: 14px;
		padding: 10px 16px;
		text-align: center;
	}

	.hd__cta--contact {
		--btn-border: var(--text);
		--btn-hover-text: var(--accent);
	}

	@media (max-width: 900px) {
		.hd__toggle {
			display: flex;
			position: relative;
			z-index: 2;
			width: 44px;
			height: 44px;
			align-items: center;
			justify-content: center;
			margin-right: -8px;
			-webkit-tap-highlight-color: transparent;
		}

		/* Le tre linee diventano una X */
		.hd__toggle span {
			position: absolute;
			width: 24px;
			transition: transform 0.35s var(--ease-out-crit), opacity 0.2s ease;
		}
		.hd__toggle span:nth-child(1) { transform: translateY(-7px); }
		.hd__toggle span:nth-child(3) { transform: translateY(7px); }
		.hd__toggle[aria-expanded='true'] span:nth-child(1) { transform: rotate(45deg); }
		.hd__toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
		.hd__toggle[aria-expanded='true'] span:nth-child(3) { transform: rotate(-45deg); }

		/* Pannello a tutto schermo sotto la barra */
		.hd__nav {
			position: fixed;
			inset: var(--hd-h) 0 0 0;
			z-index: 1;
			flex: none;
			flex-direction: column;
			align-items: stretch;
			justify-content: space-between;
			gap: 28px;
			padding: 28px 24px max(24px, env(safe-area-inset-bottom));
			overflow-y: auto;
			overscroll-behavior: contain;
			color: var(--text-on-dark);
			background:
				radial-gradient(120% 60% at 100% 0%, rgba(236, 116, 15, 0.22), transparent 60%),
				var(--bg-dark);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-12px);
			transition: opacity 0.3s ease, transform 0.45s var(--ease-out-crit), visibility 0s 0.45s;
		}

		.hd__nav.hd__nav--aperto {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition: opacity 0.3s ease, transform 0.45s var(--ease-out-crit), visibility 0s;
		}

		:global(html.hd-lock) {
			overflow: hidden;
		}

		.hd__mega {
			flex-direction: column;
			align-items: stretch;
			gap: 26px;
			margin: 0;
			counter-reset: sezione;
		}

		.hd__col {
			counter-increment: sezione;
			padding-top: 18px;
			border-top: 1px solid rgba(255, 255, 255, 0.14);
		}

		.hd__col + .hd__col::before {
			display: none;
		}

		.hd__col-title {
			display: flex;
			align-items: baseline;
			gap: 12px;
			margin-bottom: 12px;
			color: var(--text-on-dark);
			font-size: 1.35rem;
			font-weight: 700;
			letter-spacing: -0.01em;
		}

		.hd__col-title::before {
			content: counter(sezione, decimal-leading-zero);
			color: var(--accent);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.08em;
		}

		.hd__chevron {
			display: none;
		}

		/* Le voci in due colonne, cosi' entra tutto senza troppo scroll */
		.hd__col > ul {
			position: static;
			opacity: 1;
			visibility: visible;
			transform: none;
			min-width: 0;
			background: none;
			box-shadow: none;
			border: none;
			border-radius: 0;
			padding: 0;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2px 16px;
		}

		.hd__col > ul li a {
			padding: 9px 0;
			color: rgba(255, 255, 255, 0.78);
			font-size: 0.95rem;
			font-weight: 500;
		}

		.hd__col > ul li a:hover,
		.hd__col > ul li a:active {
			color: var(--accent);
		}

		.hd__actions {
			flex-direction: column;
			gap: 10px;
		}

		.hd__cta {
			width: 100%;
			padding: 14px 16px;
			font-size: 15px;
		}

		.hd__cta--contact {
			--btn-border: var(--text-on-dark);
			--btn-hover-text: var(--accent);
		}

		/* Ingresso a cascata dei contenuti */
		.hd__col,
		.hd__actions {
			opacity: 0;
			transform: translateY(14px);
			transition: opacity 0.4s ease, transform 0.5s var(--ease-out-crit);
		}

		.hd__nav--aperto .hd__col,
		.hd__nav--aperto .hd__actions {
			opacity: 1;
			transform: none;
		}

		.hd__nav--aperto .hd__col:nth-child(1) { transition-delay: 0.08s; }
		.hd__nav--aperto .hd__col:nth-child(2) { transition-delay: 0.16s; }
		.hd__nav--aperto .hd__col:nth-child(3) { transition-delay: 0.24s; }
		.hd__nav--aperto .hd__actions { transition-delay: 0.32s; }
	}

	@media (max-width: 900px) and (prefers-reduced-motion: reduce) {
		.hd__nav,
		.hd__col,
		.hd__actions {
			transition: none !important;
		}
	}
</style>
