---
import { megaMenu } from '../data/nav';

interface Props {
	/** Trasparente in cima, sopra una hero scura; si riempie scorrendo.
	 *  Se false l'header e' sempre pieno (pagine con sfondo chiaro). */
	overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header class:list={['hd', { 'hd--scrolled': !overlay }]} data-overlay={overlay ? 'true' : 'false'}>
	<div class="hd__bar container">
		<a class="hd__logo" href="/" aria-label="Body Energie - Home"></a>

		<button
			class="hd__toggle"
			type="button"
			aria-label="Apri il menu"
			aria-expanded="false"
			aria-controls="hd-nav"
			data-hd-toggle
		>
			<span></span><span></span><span></span>
		</button>

		<nav class="hd__nav" id="hd-nav" aria-label="Principale" data-hd-nav>
			<ul class="hd__mega">
				{
					megaMenu.map((colonna, i) => (
						<li class="hd__col" data-hd-col>
							<button class="hd__col-title" type="button" aria-expanded="false" aria-controls={`hd-sub-${i}`}>
								{colonna.titolo}
								<svg class="hd__chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
									<path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.5" fill="none" />
								</svg>
							</button>
							<ul id={`hd-sub-${i}`}>
								{colonna.voci.map((voce) => (
									<li>
										<a href={voce.href}>{voce.label}</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
			<div class="hd__actions">
				<button
					class="btn btn--sm btn--light hd__cta hd__cta--contact"
					type="button"
					data-open-contact
					data-interest="informazioni"
				>
					Contattaci
				</button>
				<button class="btn btn--sm hd__cta" type="button" data-open-contact data-interest="abbonamento">I nostri abbonamenti</button>
			</div>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.hd');
	const toggle = document.querySelector<HTMLButtonElement>('[data-hd-toggle]');
	const nav = document.querySelector<HTMLElement>('[data-hd-nav]');

	// --- Menu mobile -----------------------------------------------------
	function setNavOpen(open: boolean) {
		nav?.classList.toggle('hd__nav--aperto', open);
		document.body.classList.toggle('hd-menu-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
	}
	toggle?.addEventListener('click', () => setNavOpen(toggle.getAttribute('aria-expanded') !== 'true'));

	// --- Mega-menu desktop: disclosure raggiungibile da tastiera ----------
	// Mouse: si apre al passaggio. Tastiera e touch: il titolo e' un bottone
	// (Invio/Spazio/tocco). Esc chiude e riporta il focus sul titolo.
	const cols = Array.from(document.querySelectorAll<HTMLElement>('[data-hd-col]'));
	function setColOpen(col: HTMLElement, open: boolean) {
		col.classList.toggle('is-open', open);
		col.querySelector('.hd__col-title')?.setAttribute('aria-expanded', String(open));
	}
	function closeAllCols(except?: HTMLElement) {
		cols.forEach((c) => c !== except && setColOpen(c, false));
	}

	cols.forEach((col) => {
		const btn = col.querySelector<HTMLButtonElement>('.hd__col-title');
		col.addEventListener('pointerenter', (e) => {
			if (e.pointerType !== 'mouse') return;
			closeAllCols(col);
			setColOpen(col, true);
		});
		col.addEventListener('pointerleave', (e) => {
			if (e.pointerType !== 'mouse') return;
			if (!col.contains(document.activeElement)) setColOpen(col, false);
		});
		btn?.addEventListener('click', (e) => {
			// Un clic di mouse arriva con il menu gia' aperto dal passaggio.
			if ((e as PointerEvent).pointerType === 'mouse') return;
			const open = !col.classList.contains('is-open');
			closeAllCols(col);
			setColOpen(col, open);
		});
		col.addEventListener('focusout', (e) => {
			if (!col.contains(e.relatedTarget as Node | null)) setColOpen(col, false);
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const open = cols.find((c) => c.classList.contains('is-open'));
		if (open) {
			setColOpen(open, false);
			open.querySelector<HTMLButtonElement>('.hd__col-title')?.focus();
		}
		if (toggle?.getAttribute('aria-expanded') === 'true') {
			setNavOpen(false);
			toggle.focus();
		}
	});
	document.addEventListener('click', (e) => {
		if (!(e.target as Element).closest('[data-hd-col]')) closeAllCols();
	});

	// --- Header trasparente -> pieno scorrendo (solo con hero scura) ------
	if (header?.dataset.overlay === 'true') {
		const aggiornaScroll = () => header.classList.toggle('hd--scrolled', window.scrollY > 10);
		aggiornaScroll();
		window.addEventListener('scroll', aggiornaScroll, { passive: true });
	}
</script>

<style>
	.hd {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 40;
		height: var(--header-h);
		background: transparent;
		border-bottom: 1px solid transparent;
		transition: background 0.3s ease, border-color 0.3s ease;
	}

	/* In cima, sopra la hero scura: voci di menu, logo e hamburger chiari.
	   Appena si scorre (o su pagine senza hero scura) torna l'header pieno,
	   sfondo crema, voci nere, logo scuro. */
	.hd__col-title,
	.hd__chevron {
		color: var(--text-on-dark);
	}

	.hd__col + .hd__col::before {
		background: var(--text-on-dark);
	}

	.hd.hd--scrolled {
		background: var(--bg-alt);
		border-bottom-color: var(--border);
	}

	.hd--scrolled .hd__col-title,
	.hd--scrolled .hd__chevron {
		color: var(--text);
	}

	.hd--scrolled .hd__col + .hd__col::before {
		background: var(--accent);
	}

	.hd__chevron {
		margin-left: 4px;
		vertical-align: middle;
	}

	.hd__actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	/* L'altezza la decide --header-h: la barra la riempie, il contenuto si centra. */
	.hd__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
	}

	/* Due livelli: il logo chiaro (hero scura) e quello scuro (header pieno),
	   entrambi caricati subito, si alterna solo la dimensione: niente lampi. */
	.hd__logo {
		display: block;
		width: 113px;
		height: 44px;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		background-image: url('/images/logo-body-energie-chiaro.png'), url('/wp-content/uploads/2025/10/Logo-Body-Energie-header.png');
		background-repeat: no-repeat;
		background-position: left center, left center;
		background-size: contain, 0 0;
	}

	.hd--scrolled .hd__logo {
		background-size: 0 0, contain;
	}

	.hd__toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		padding: 14px 8px;
		background: none;
		border: none;
		cursor: pointer;
	}

	.hd__toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text-on-dark);
	}

	.hd--scrolled .hd__toggle span {
		background: var(--text);
	}

	.hd__nav {
		display: flex;
		align-items: center;
		flex: 1;
	}

	/* Margini automatici sui due lati: il menu resta sempre esattamente a
	   meta' strada tra il logo e i bottoni, qualunque sia la loro larghezza. */
	.hd__mega {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 20px;
		margin-inline: auto;
		padding: 0;
	}

	.hd__col {
		position: relative;
	}

	.hd__col + .hd__col::before {
		content: '';
		position: absolute;
		left: -10px;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 22px;
	}

	.hd__col-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		line-height: inherit;
		padding: 6px 0;
		background: none;
		border: none;
		cursor: pointer;
	}

	.hd__col > ul {
		list-style: none;
		margin: 0;
		padding: 12px;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 220px;
		background: var(--bg);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: 0.15s ease;
	}

	.hd__col.is-open > ul {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.hd__col > ul li a {
		display: block;
		padding: 6px 4px;
		color: var(--text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.hd__col > ul li a:hover,
	.hd__col > ul li a:focus-visible {
		color: var(--accent);
	}

	.hd__col-title:focus-visible,
	.hd__toggle:focus-visible,
	.hd__logo:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* Bottoni piccoli che vanno a capo solo se proprio necessario. */
	.hd__cta {
		white-space: normal;
		text-align: center;
	}

	/* Il bottone "Contattaci" ha bordo bianco sopra la hero scura e nero
	   sull'header pieno (stessa regola dell'hover: bordo nero -> testo arancione). */
	.hd--scrolled .hd__cta--contact {
		--btn-border: var(--text);
	}

	@media (max-width: 900px) {
		.hd__toggle {
			display: flex;
		}

		/* Il pannello mobile e' sempre crema, quindi le sue voci sono sempre
		   scure, qualunque sia lo stato dell'header sotto (trasparente o pieno). */
		.hd__nav {
			position: fixed;
			inset: var(--header-h) 0 0 0;
			background: var(--bg-alt);
			flex-direction: column;
			align-items: stretch;
			padding: 20px;
			overflow-y: auto;
			display: none;
		}

		.hd__nav.hd__nav--aperto {
			display: flex;
		}

		.hd__nav .hd__col-title,
		.hd__nav .hd__chevron {
			color: var(--text);
		}

		.hd__nav .hd__cta--contact {
			--btn-border: var(--text);
		}

		.hd__mega {
			flex-direction: column;
			gap: 20px;
		}

		.hd__col + .hd__col::before {
			display: none;
		}

		.hd__col > ul {
			position: static;
			opacity: 1;
			visibility: visible;
			transform: none;
			box-shadow: none;
			border: none;
			padding: 8px 0 0 12px;
			display: block;
		}

		.hd__chevron {
			display: none;
		}
	}

	/* Il passaggio del mouse apre il menu solo dove esiste un mouse vero. */
	@media (hover: hover) and (pointer: fine) and (min-width: 901px) {
		.hd__col:hover > ul {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}
	}
</style>

<style is:global>
	body.hd-menu-open {
		overflow: hidden;
	}
</style>
