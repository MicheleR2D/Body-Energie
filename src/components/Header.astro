---
import { megaMenu } from '../data/nav';
---

<header class="hd">
	<div class="hd__bar container">
		<a class="hd__logo" href="/" aria-label="Body Energie - Home"></a>

		<button class="hd__toggle" type="button" aria-label="Apri il menu" aria-expanded="false" data-hd-toggle>
			<span></span><span></span><span></span>
		</button>

		<nav class="hd__nav" data-hd-nav>
			<ul class="hd__mega">
				{
					megaMenu.map((colonna) => (
						<li class="hd__col">
							<span class="hd__col-title">
								{colonna.titolo}
								<svg class="hd__chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
									<path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.5" fill="none" />
								</svg>
							</span>
							<ul>
								{colonna.voci.map((voce) => (
									<li>
										<a href={voce.href}>{voce.label}</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
			<div class="hd__actions">
				<button
					class="btn btn--outline hd__cta hd__cta--contact"
					type="button"
					data-open-contact
					data-interest="informazioni"
				>
					Contattaci
				</button>
				<a class="btn hd__cta hd__cta--primary" href="/abbonamenti">I nostri abbonamenti</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector('[data-hd-toggle]');
	const nav = document.querySelector('[data-hd-nav]');
	toggle?.addEventListener('click', () => {
		const aperto = nav?.classList.toggle('hd__nav--aperto');
		toggle.setAttribute('aria-expanded', aperto ? 'true' : 'false');
	});

	// L'header cambia colore (sfondo a gradiente, voci col colore che
	// prima era lo sfondo) appena si inizia a scorrere la pagina.
	const header = document.querySelector('.hd');
	const aggiornaScroll = () => header?.classList.toggle('hd--scrolled', window.scrollY > 10);
	aggiornaScroll();
	window.addEventListener('scroll', aggiornaScroll, { passive: true });
</script>

<style>
	.hd {
		background: transparent;
		border-bottom: 1px solid transparent;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 40;
		transition: background 0.3s ease, border-color 0.3s ease;
	}

	/* In cima alla pagina l'header e' trasparente (sopra la hero scura):
	   voci di menu' bianche. Appena si scorre torna l'header originale,
	   sfondo crema pieno, voci di menu' nel colore originale (nero). */
	.hd__col-title,
	.hd__chevron {
		color: var(--text-on-dark);
	}

	.hd__col + .hd__col::before {
		background: var(--text-on-dark);
	}

	.hd.hd--scrolled {
		background: var(--bg-alt);
		border-bottom-color: var(--border);
	}

	.hd--scrolled .hd__col-title,
	.hd--scrolled .hd__chevron {
		color: var(--text);
	}

	.hd--scrolled .hd__col + .hd__col::before {
		background: var(--accent);
	}

	.hd__chevron {
		margin-left: 4px;
		vertical-align: middle;
	}

	.hd__actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.hd__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 8px;
	}

	.hd__logo {
		text-decoration: none;
		display: block;
		-webkit-tap-highlight-color: transparent;
		width: 113px;
		height: 44px;
		background-image: url('/wp-content/uploads/2025/10/Logo-Body-Energie-header.png');
		background-repeat: no-repeat;
		background-position: left center;
		background-size: contain;
	}

	.hd__toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		padding: 8px;
	}

	.hd__toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text);
	}

	.hd__nav {
		display: flex;
		align-items: center;
		flex: 1;
	}

	/* Margini automatici sui due lati: il menu resta sempre esattamente a
	   meta' strada tra il logo e i bottoni, qualunque sia la loro larghezza. */
	.hd__mega {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 20px;
		margin-inline: auto;
		padding: 0;
	}

	.hd__col {
		position: relative;
	}

	.hd__col + .hd__col::before {
		content: '';
		position: absolute;
		left: -10px;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 22px;
	}

	.hd__col-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		cursor: default;
	}

	.hd__col > ul {
		list-style: none;
		margin: 0;
		padding: 12px;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 220px;
		background: var(--bg);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: 0.15s ease;
	}

	.hd__col:hover > ul,
	.hd__col:focus-within > ul {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.hd__col > ul li a {
		display: block;
		padding: 6px 4px;
		color: var(--text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.hd__col > ul li a:hover {
		color: var(--accent);
	}

	.hd__cta {
		white-space: normal;
		font-size: 14px;
		padding: 10px 16px;
		text-align: center;
	}

	.hd__cta--contact {
		--btn-border: var(--text-on-dark);
		--btn-hover-text: var(--accent);
	}

	/* Header scrollato: l'header torna crema, quindi il bottone torna al
	   bordo/testo neri (con la stessa regola dell'hover: bordo nero ->
	   testo in hover arancione). */
	.hd--scrolled .hd__cta--contact {
		--btn-border: var(--text);
		--btn-hover-text: var(--accent);
	}

	@media (max-width: 900px) {
		.hd__toggle {
			display: flex;
		}

		.hd__nav {
			position: fixed;
			inset: 72px 0 0 0;
			background: var(--bg-alt);
			flex-direction: column;
			align-items: stretch;
			padding: 20px;
			overflow-y: auto;
			display: none;
		}

		.hd__nav.hd__nav--aperto {
			display: flex;
		}

		.hd__mega {
			flex-direction: column;
			gap: 20px;
		}

		.hd__col > ul {
			position: static;
			opacity: 1;
			visibility: visible;
			transform: none;
			box-shadow: none;
			border: none;
			padding: 8px 0 0 12px;
			display: block;
		}
	}
</style>
