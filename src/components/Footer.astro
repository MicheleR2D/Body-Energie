---
import { megaMenu } from '../data/nav';

// Stesso contenuto reale del footer originale (post ID 1068 di Elementor) e stessi
// loghi partner, riorganizzato in: CTA principale, "dove siamo" con mappa,
// colonne di link, fascia loghi, riga finale con i documenti legali.
// La sezione "dove siamo" sostituisce con una mappa statica il widget a
// pagamento Elfsight Store Locator del sito originale (stessi dati reali:
// indirizzo, telefono, email), per non introdurre un nuovo servizio a pagamento.
const address = 'Via Adamello, 1, 37069 Villafranca di Verona (VR)';
const mapsEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const mapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;

// Icone SVG inline (viewBox 24x24): niente librerie esterne per tre simboli.
const social = [
	{
		href: 'https://www.facebook.com/www.bodyenergie.it',
		label: 'Facebook',
		icon: '<path fill="currentColor" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/>',
	},
	{
		href: 'https://www.instagram.com/body_energie/',
		label: 'Instagram',
		icon: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/>',
	},
	{
		href: 'https://www.youtube.com/@bodyenergie1631',
		label: 'YouTube',
		icon: '<path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>',
	},
];

const orari = [
	{
		titolo: 'Orari Centro',
		righe: [
			{ giorni: 'Lun - Ven', ore: '5.00 - 22.00' },
			{ giorni: 'Sabato', ore: '8.00 - 18.00' },
			{ giorni: 'Domenica', ore: '8.00 - 13.30' },
		],
	},
	{
		titolo: 'Orari Termarium',
		righe: [
			{ giorni: 'Lun - Mar - Gio', ore: '10.00 - 21.00' },
			{ giorni: 'Sabato', ore: '10.00 - 17.30' },
			{ giorni: 'Domenica', ore: '10.00 - 13.00' },
		],
	},
];

const legalLinks = [
	{ href: '/privacy-body-energie', label: 'Privacy' },
	{ href: '/wp-content/uploads/2025/12/Regolamento-Body-Energie.pdf', label: 'Regolamento', esterno: true },
	{
		href: '/wp-content/uploads/2025/12/MODELLO-ORGANIZZATIVO-E-DI-CONTROLLO-DELLATTIVITA-SPORTIVA.pdf',
		label: 'Modello Organizzativo',
		esterno: true,
	},
	{ href: '/wp-content/uploads/2025/12/contributi.pdf', label: 'Contributi Pubblici', esterno: true },
];

// Stessi loghi del sito originale, ritagliati dai margini vuoti (in
// public/images/loghi/) per poterli mostrare tutti alla stessa scala.
const partner = [
	{ src: '/images/loghi/asi.png', alt: 'ASI' },
	{ src: '/images/loghi/coni.png', alt: 'CONI' },
	{ src: '/images/loghi/anif.png', alt: 'ANIF' },
	{ src: '/images/loghi/csen.png', alt: 'CSEN' },
	{ src: '/images/loghi/technogym.png', alt: 'Technogym' },
	{ src: '/images/loghi/mediolanum.png', alt: 'Banca Mediolanum' },
	{ src: '/images/loghi/group-cycling.png', alt: 'Group Cycling' },
	{ src: '/images/loghi/peak-pilates.png', alt: 'Peak Pilates' },
	{ src: '/images/loghi/les-mills.png', alt: 'Les Mills' },
	{ src: '/images/loghi/ekoi.png', alt: 'EKOI' },
	{ src: '/images/loghi/zumba.png', alt: 'Zumba Fitness' },
];

// I 4 loghi della striscia "Coesione" del sito originale, separati: per i
// progetti cofinanziati vanno mostrati a colori e sempre visibili, e
// rimandano alla pagina del contributo come la striscia originale.
const loghiCofinanziamento = [
	{ src: '/images/loghi/coesione-italia.png', alt: 'Coesione Italia 21-27 Veneto' },
	{ src: '/images/loghi/unione-europea.png', alt: "Cofinanziato dall'Unione europea" },
	{ src: '/images/loghi/repubblica-italiana.png', alt: 'Repubblica Italiana' },
	{ src: '/images/loghi/regione-veneto.png', alt: 'Regione del Veneto' },
];

const info = [
	{ href: '/orari', label: 'Planning settimanale' },
	{ href: '/abbonamenti', label: 'Abbonamenti' },
	// TODO: nel sito originale il bottone "Posizioni aperte" non aveva una destinazione configurata
	{ href: '#', label: 'Lavora con noi' },
];

// Stessi numeri della sezione contatori della home (e stesso formato con la
// virgola del sito originale): qui fanno da prova sociale accanto alla CTA.
const provaSociale = [
	{ numero: '5,500', etichetta: 'mq di centro' },
	{ numero: '150+', etichetta: 'corsi a settimana' },
	{ numero: '40+', etichetta: 'trainer qualificati' },
	{ numero: '2,000+', etichetta: 'iscritti' },
];

const colonneFoto = [
	[
		'/wp-content/uploads/2025/12/Body-Energie-Ambienti-57-scaled.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Azioni-64-scaled.jpg',
		'/wp-content/uploads/2025/12/Body-Energie-Piscina-2-scaled.jpg',
	],
	[
		'/wp-content/uploads/2025/08/IMG-20210528-WA0046.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Azioni-62-scaled.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Ambienti-70-scaled.jpg',
	],
	[
		'/wp-content/uploads/2025/11/Body-Energie-Ambienti-25-scaled.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Ambienti-48-scaled.jpg',
		'/wp-content/uploads/2025/12/Body-Energie-Piscina-7-scaled.jpg',
	],
];
---

<footer class="ft">
	<section class="cta-final" aria-labelledby="cta-final-title">
		<div class="cta-final__content">
			<p class="cta-final__eyebrow" data-anim="pop">Inizia oggi!</p>
			<h2 class="cta-final__title" id="cta-final-title" data-anim="up" data-anim-delay="120">
				Prova <span class="cta-final__title-accent">ora</span><br />il nostro centro
			</h2>
			<p class="cta-final__lead" data-anim="up" data-anim-delay="240">Lascia i tuoi dati: ti ricontattiamo noi per organizzare la tua prova.</p>

			<ul class="cta-final__proof">
				{
					provaSociale.map((p, i) => (
						<li data-anim="up" data-anim-delay={String(360 + i * 100)}>
							<strong>{p.numero}</strong>
							<span>{p.etichetta}</span>
						</li>
					))
				}
			</ul>

			<div class="cta-final__actions" data-anim="up" data-anim-delay="760">
				<button class="btn cta-final__btn" type="button" data-open-contact data-interest="prova-gratuita">
					Attiva ora <span class="cta-final__btn-arrow" aria-hidden="true">→</span>
				</button>
			</div>
		</div>

		<div class="cta-final__wall" aria-hidden="true" data-anim="from-right">
			{
				colonneFoto.map((colonna, i) => (
					<div class={`cta-final__col ${i === 1 ? 'cta-final__col--down' : ''}`}>
						<div class="cta-final__track">
							{[...colonna, ...colonna].map((src) => (
								<img src={src} alt="" loading="lazy" />
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="find-us" aria-labelledby="find-us-title">
		<div class="find-us__content">
			<p class="find-us__eyebrow" data-anim="pop">Dove siamo</p>
			<h2 class="find-us__title" id="find-us-title" data-anim="up" data-anim-delay="120">
				Vieni a <span class="find-us__title-accent">trovarci</span>
			</h2>

			<div class="find-us__orari">
				{
					orari.map((o, i) => (
						<div class="find-us__orari-card" data-anim="up" data-anim-delay={String(240 + i * 120)}>
							<p class="find-us__label">{o.titolo}</p>
							<dl class="find-us__orari-list">
								{o.righe.map((r) => (
									<div>
										<dt>{r.giorni}</dt>
										<dd>{r.ore}</dd>
									</div>
								))}
							</dl>
						</div>
					))
				}
			</div>

			<div class="find-us__cta" data-anim="up" data-anim-delay="480">
				<a class="btn btn--outline" href={mapsDirectionsUrl} target="_blank" rel="noopener">
					Indicazioni
				</a>
				<button class="btn" type="button" data-open-contact data-interest="informazioni">Contattaci</button>
			</div>
		</div>

		<div class="find-us__map" data-anim="from-left">
			<iframe
				src={mapsEmbedSrc}
				title={`Mappa - Body Energie, ${address}`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
	</section>

	<div class="ft-main">
		<div class="ft-brand" data-anim="up">
			<img
				class="ft-brand__logo"
				src="/images/logo-body-energie-chiaro.png"
				alt="Body Energie"
				height="40"
			/>
			<p class="ft-brand__blurb">
				Body Energie è il tuo punto di riferimento per fitness, benessere e sport a Villafranca di Verona. Attrezzature
				all'avanguardia, corsi per ogni livello e un'offerta completa per adulti e bambini.
			</p>
			<div class="ft-social">
				{
					social.map((s) => (
						<a class="ft-social__btn" href={s.href} target="_blank" rel="noopener" aria-label={`Body Energie su ${s.label}`}>
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={s.icon} />
						</a>
					))
				}
			</div>
		</div>

		{
			megaMenu.map((colonna, i) => (
				<nav class="ft-col" aria-label={colonna.titolo} data-anim="up" data-anim-delay={String(80 + i * 80)}>
					<p class="ft-heading">{colonna.titolo}</p>
					<ul class="ft-links">
						{colonna.voci.map((voce) => (
							<li>
								<a href={voce.href}>{voce.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}

		<div class="ft-col" data-anim="up" data-anim-delay="320">
			<p class="ft-heading">Info</p>
			<ul class="ft-links">
				{
					info.map((l) => (
						<li>
							<a href={l.href}>{l.label}</a>
						</li>
					))
				}
			</ul>
			<details class="ft-estivi">
				<summary>Orari estivi</summary>
				<p class="ft-estivi__title">Centro</p>
				<ul>
					<li>Lun - Ven: 5.00 - 22.00</li>
					<li>Sabato: 8.00 - 13.30</li>
					<li>Domenica: 8.00 - 13.30</li>
				</ul>
				<p class="ft-estivi__title">Termarium</p>
				<ul>
					<li>Lunedì: 18.00 - 21.00</li>
					<li>Giovedì: 10.00 - 21.00</li>
				</ul>
			</details>
		</div>
	</div>

	<section class="ft-loghi" aria-label="Partner e istituzioni">
		<p class="ft-heading">Partner e istituzioni</p>
		<ul class="ft-tiles">
			{
				partner.map((p, i) => (
					<li class="ft-tile" data-anim="up" data-anim-delay={String(i * 50)}>
						<img src={p.src} alt={p.alt} loading="lazy" />
					</li>
				))
			}
			{
				loghiCofinanziamento.map((l, i) => (
					<li class="ft-tile" data-anim="up" data-anim-delay={String((partner.length + i) * 50)}>
						<a href="/contributo-regione-veneto">
							<img src={l.src} alt={l.alt} loading="lazy" />
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<div class="ft-bottom">
		<div class="ft-bottom__row">
			<p>© {new Date().getFullYear()} Body Energie ssd a.r.l. · P.IVA 03716930239 · {address}</p>
			<ul class="ft-legal">
				{
					legalLinks.map((l) => (
						<li>
							<a href={l.href} target={l.esterno ? '_blank' : undefined} rel={l.esterno ? 'noopener' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="ft-bottom__row">
			<p>Sito web per la Propaganda dell'Attività Fisica Sportiva Dilettantistica</p>
			<div class="ft-firma">
				<span>Powered by</span>
				<a href="https://ready2digital.it" target="_blank" rel="noopener">
					<img src="/wp-content/uploads/2026/04/R2D.png" alt="Ready 2 Digital" height="16" />
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.ft {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.ft h2 {
		color: var(--text-on-dark);
	}

	/* --- CTA principale del sito: testo a sinistra, muro di foto a destra --- */
	/* Alta esattamente una schermata, al netto dell'header fisso (~75px). */
	.cta-final {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		height: calc(100vh - 75px);
		height: calc(100svh - 75px);
		min-height: 560px;
		overflow: hidden;
		background: var(--accent);
		color: var(--text);
	}

	.cta-final__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 60px 72px 60px 5vw;
	}

	.cta-final__eyebrow {
		display: inline-block;
		align-self: flex-start;
		margin: 0 0 20px;
		padding: 6px 14px;
		border-radius: 999px;
		background: var(--text);
		color: var(--text-on-dark);
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.ft .cta-final__title {
		margin: 0;
		font-size: clamp(2.4rem, 4.4vw, 4.25rem);
		font-weight: 900;
		line-height: 0.95;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.cta-final__title-accent {
		color: var(--text-on-dark);
		font-style: italic;
	}

	.cta-final__lead {
		max-width: 30rem;
		margin: 24px 0 0;
		font-size: var(--text-md);
		line-height: 1.5;
	}

	.cta-final__proof {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}

	.cta-final__proof li {
		display: flex;
		flex-direction: column;
		padding: 0 24px;
		border-left: 1px solid var(--text);
	}

	.cta-final__proof li:first-child {
		padding-left: 0;
		border-left: none;
	}

	.cta-final__proof strong {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.4vw, 2.25rem);
		font-weight: 900;
		line-height: 1;
		color: var(--text-on-dark);
	}

	.cta-final__proof span {
		margin-top: 6px;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.cta-final__actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px 28px;
		margin-top: 32px;
	}

	/* Bordo bianco -> in hover riempimento bianco e testo arancione. */
	.cta-final__btn {
		--btn-border: var(--text-on-dark);
		--btn-hover-text: var(--accent);
		display: inline-flex;
		align-items: center;
		gap: 14px;
		padding: 22px 44px;
		font-size: 18px;
		letter-spacing: 0.04em;
		animation: cta-pulse 2.4s ease-out infinite;
	}

	.cta-final__btn-arrow {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-crit, ease);
	}

	.cta-final__btn:hover .cta-final__btn-arrow {
		transform: translateX(6px);
	}

	/* Anello che si espande intorno al bottone: attira l'occhio sulla CTA
	   senza muovere il bottone stesso. */
	@keyframes cta-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55);
		}
		70%,
		100% {
			box-shadow: 0 0 0 16px rgba(255, 255, 255, 0);
		}
	}

	/* Tre colonne verticali di foto: quella centrale scorre al contrario.
	   La maschera le fa sfumare nell'arancione in alto e in basso. */
	.cta-final__wall {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
		padding-right: 5vw;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
	}

	.cta-final__track {
		animation: cta-scroll-up 38s linear infinite;
	}

	.cta-final__col--down .cta-final__track {
		animation-name: cta-scroll-down;
	}

	.cta-final__wall:hover .cta-final__track {
		animation-play-state: paused;
	}

	.cta-final__track img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		margin-bottom: 14px;
		object-fit: cover;
		border-radius: 14px;
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
	}

	@keyframes cta-scroll-up {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-50%);
		}
	}

	@keyframes cta-scroll-down {
		from {
			transform: translateY(-50%);
		}
		to {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-final__btn,
		.cta-final__track {
			animation: none;
		}
	}

	/* In colonna: testo sopra, le foto riempiono lo spazio rimasto fino a
	   fine schermata (header mobile ~61px). */
	@media (max-width: 900px) {
		.cta-final {
			display: flex;
			flex-direction: column;
			height: calc(100vh - 61px);
			height: calc(100svh - 61px);
			min-height: 0;
		}

		.cta-final__content {
			padding: 36px 5vw 24px;
		}

		.cta-final__lead {
			margin-top: 16px;
		}

		.cta-final__proof {
			grid-template-columns: repeat(2, auto);
			row-gap: 16px;
			margin-top: 20px;
		}

		.cta-final__proof li:nth-child(3) {
			padding-left: 0;
			border-left: none;
		}

		.cta-final__actions {
			margin-top: 24px;
		}

		.cta-final__wall {
			flex: 1;
			min-height: 140px;
			padding-inline: 5vw;
		}
	}

	@media (max-width: 560px) {
		.cta-final__btn {
			width: 100%;
			justify-content: center;
		}
	}

	/* --- "Dove siamo": mappa + info + cta --- */
	/* Stessa struttura della CTA sopra: alta una schermata (al netto
	   dell'header fisso), ma speculare: mappa a sinistra, testo a destra,
	   su fondo bianco. Nel codice il testo resta prima della mappa, cosi'
	   su mobile sta sopra. */
	.find-us {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		height: calc(100vh - 75px);
		height: calc(100svh - 75px);
		min-height: 560px;
		background: var(--bg);
		color: var(--text);
	}

	.find-us__content {
		grid-column: 2;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 60px 5vw 60px 72px;
	}

	.find-us__eyebrow {
		align-self: flex-start;
		margin: 0 0 20px;
		padding: 6px 14px;
		border-radius: 999px;
		background: var(--accent);
		color: var(--text);
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.ft .find-us__title {
		margin: 0;
		font-size: clamp(2.4rem, 4.4vw, 4.25rem);
		font-weight: 900;
		line-height: 0.95;
