---
import MediaCarousel from './MediaCarousel.astro';

interface Item {
	title: string;
	html?: string;
	images?: string[];
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---

<div class="acc">
	{
		items.map((item, i) => (
			<div class="acc__item">
				<button class="acc__trigger" type="button" data-acc-trigger aria-expanded="false">
					<span class="acc__icon" aria-hidden="true">
						+
					</span>
					{item.title}
				</button>
				<div class="acc__panel" hidden>
					<div class="acc__panel-inner">
						{item.images && item.images.length > 0 && (
							<MediaCarousel images={item.images.map((src) => ({ src }))} />
						)}
						{item.html && <div class="acc__text" set:html={item.html} />}
					</div>
				</div>
			</div>
		))
	}
</div>

<script>
	document.querySelectorAll('[data-acc-trigger]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const panel = btn.nextElementSibling;
			const aperto = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!aperto));
			if (panel) panel.hidden = aperto;
			const icon = btn.querySelector('[aria-hidden]');
			if (icon) icon.textContent = aperto ? '+' : '−';
		});
	});
</script>

<style>
	.acc__item {
		border-bottom: 2px solid var(--text);
		margin-bottom: 12px;
	}

	.acc__trigger {
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		background: var(--bg-cream);
		color: var(--text);
		border: none;
		border-radius: var(--radius) var(--radius) 0 0;
		padding: 18px 24px;
		font-family: var(--font-heading);
		font-weight: 700;
		text-transform: uppercase;
		font-size: var(--text-md);
		text-align: left;
		cursor: pointer;
	}

	.acc__trigger:hover {
		color: var(--accent-secondary);
	}

	.acc__icon {
		font-size: 22px;
		width: 1em;
	}

	.acc__panel-inner {
		background: var(--bg-cream);
		padding: 0 24px 24px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		align-items: center;
	}

	.acc__text {
		color: var(--text);
	}

	@media (max-width: 800px) {
		.acc__panel-inner {
			grid-template-columns: 1fr;
		}
	}
</style>
