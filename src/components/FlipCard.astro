---
interface Props {
	href: string;
	image: string;
	title: string;
	tagline: string;
	titleBack?: string;
	description: string;
}
const { href, image, title, tagline, titleBack, description } = Astro.props;
---

<a class="fc" href={href}>
	<div class="fc__front" style={`background-image:linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.15) 55%, transparent 100%), url(${image})`}>
		<h3 class="fc__title">{title}</h3>
		<p class="fc__tagline">{tagline}</p>
	</div>
	<div class="fc__back">
		<h3 class="fc__title fc__title--back">{titleBack || title}</h3>
		<p class="fc__desc">{description}</p>
		<span class="btn btn--dark fc__cta">Scopri di più</span>
	</div>
</a>

<style>
	.fc {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		color: var(--text-on-dark);
		text-decoration: none;
	}

	.fc__front,
	.fc__back {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 24px;
		transition: opacity 0.2s ease;
	}

	.fc__front {
		background-size: cover;
		background-position: center;
	}

	.fc__title {
		margin: 0 0 4px;
		color: var(--accent);
		font-size: var(--text-md);
	}

	.fc__tagline {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-on-dark);
	}

	.fc__back {
		background: var(--accent);
		opacity: 0;
		justify-content: center;
		text-align: center;
		align-items: center;
		gap: 12px;
	}

	.fc__title--back {
		color: var(--text-on-dark);
		margin: 0;
	}

	.fc__desc {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-on-dark);
	}

	.fc__cta {
		margin-top: 8px;
	}

	.fc:hover .fc__back,
	.fc:focus-visible .fc__back {
		opacity: 1;
	}
</style>
