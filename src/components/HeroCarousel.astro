---
interface Props {
	images: string[];
}
const { images } = Astro.props;

// Stessi tempi del background-slideshow di Elementor sul sito originale:
// 5000ms di visualizzazione per foto, 500ms di dissolvenza incrociata.
const SLIDE_MS = 5000;
const FADE_MS = 500;
const count = images.length;
const totalMs = count * SLIDE_MS;
const fadeInEnd = (FADE_MS / totalMs) * 100;
const visibleEnd = ((SLIDE_MS - FADE_MS) / totalMs) * 100;
const fadeOutEnd = (SLIDE_MS / totalMs) * 100;

const keyframesCss = `
@keyframes hc-fade {
	0% { opacity: 0; }
	${fadeInEnd}% { opacity: 1; }
	${visibleEnd}% { opacity: 1; }
	${fadeOutEnd}% { opacity: 0; }
	100% { opacity: 0; }
}
`;
---

<section class="hc" style={`--hc-duration:${totalMs}ms`}>
	<div class="hc__slides">
		{
			images.map((src, i) => (
				<div class="hc__slide" style={`background-image:url(${src}); animation-delay:${i * SLIDE_MS}ms`} />
			))
		}
	</div>
	<div class="hc__overlay"></div>
	<div class="hc__content">
		<slot />
	</div>
</section>

<style is:global set:html={keyframesCss} />

<style>
	.hc {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		color: var(--text-on-dark);
	}

	.hc__slides {
		position: absolute;
		inset: 0;
	}

	.hc__slide {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0;
		animation-name: hc-fade;
		animation-duration: var(--hc-duration);
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
	}

	.hc__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.61);
	}

	.hc__content {
		position: relative;
		z-index: 1;
		text-align: center;
		padding: 32px 20px;
	}

	@media (max-width: 767px) {
		.hc {
			min-height: 74vh;
		}
	}
</style>
