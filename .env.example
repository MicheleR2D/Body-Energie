# URL pubblico del sito in produzione (usato per canonical URL, sitemap, link nelle email)
SITE_URL=https://www.bodyenergie.it

# Supabase: storage delle richieste inviate dai form del sito (sostituiscono Typeform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid: invio email di notifica allo staff quando arriva una nuova richiesta
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Body Energie
EMAIL_REPLY_TO=
EMAIL_NOTIFICHE_A=

# Consenso cookie (CookieYes) - ID cliente del banner
PUBLIC_COOKIEYES_ID=

# Google Tag Manager / GA4 - da recuperare da wp-admin/Google Site Kit prima del lancio
PUBLIC_GTM_ID=

# Meta Pixel (ID pubblico, non sensibile - gia' noto dal sito attuale: 513401372607804)
PUBLIC_META_PIXEL_ID=513401372607804

# Meta Conversions API - token server-side, da recuperare dal cliente/wp-admin
META_CAPI_ACCESS_TOKEN=
